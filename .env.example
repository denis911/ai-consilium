# AI Consilium Environment Configuration Example

# Target Obsidian Vault Path
OBSIDIAN_VAULT_PATH=C:/Users/YourName/Documents/ObsidianVault

# LLM Provider API Keys (Fill in your active keys)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Zero-Cost OpenRouter Free Tier API Key (Optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
